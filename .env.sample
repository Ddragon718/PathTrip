# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pathtrip"

# Runtime
HOST=127.0.0.1
PORT=3113
NODE_ENV=development
DEBUG_MODE=true
PRISMA_QUERY_LOG=false

# CORS (쉼표로 여러 origin 지정 가능)
CLIENT_URL=http://localhost:3000

# Auth
BCRYPT_SALT_ROUNDS=10
ACCESS_SECRET=change-me-access-secret
ACCESS_EXPIRES_IN=15m

# 로컬 테스트 계정 생성 전 각각 12~72바이트 비밀번호를 지정합니다.
# 실제 값은 .env에만 저장하며 커밋하지 않습니다.
LOCAL_TEST_USER_PASSWORD=
LOCAL_TEST_ADMIN_PASSWORD=

# Kakao Local API (지도 검색/주소 변환에만 필요)
KAKAO_MAP_REST_API_KEY=

# Google Places API (New) — 서버 전용, 클라이언트 공개 변수로 복사하지 마세요.
GOOGLE_PLACES_API_KEY=
