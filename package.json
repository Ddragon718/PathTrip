{
  "name": "path_trip",
  "version": "1.0.0",
  "description": "여행경로 자동추천서비스",
  "type": "module",
  "ts-node": {
    "esm": true,
    "experimentalResolver": true,
    "experimentalSpecifierResolution": "node"
  },
  "main": "dist/server.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  },
  "scripts": {
    "dev": "TS_NODE_TRANSPILE_ONLY=true node --watch --no-warnings=ExperimentalWarning --loader ts-node/esm src/server.ts",
    "dev:web": "npm run dev --workspace @pathtrip/web",
    "dev:mobile": "npm run start --workspace @pathtrip/mobile",
    "preview:app": "npm run preview:web --workspace @pathtrip/mobile",
    "start:web": "npm run start --workspace @pathtrip/web",
    "build": "prisma generate && tsc -p tsconfig.json",
    "build:clients": "npm run build --workspace @pathtrip/api-client && npm run build --workspace @pathtrip/web && npm run typecheck --workspace @pathtrip/mobile",
    "build:all": "npm run build && npm run build:clients",
    "start": "node dist/server.js",
    "prestart": "npm run build",
    "seed": "node prisma/seed.mjs",
    "seed:test-users": "node prisma/seed-test-users.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "test": "npm run build && npm run build --workspace @pathtrip/api-client && node --test tests/unit/*.test.mjs",
    "test:unit": "npm test",
    "test:integration:api-usage": "npm run build && node --test tests/integration/api-usage.test.mjs",
    "maps:setup": "node scripts/map-setup.mjs --prepare",
    "maps:status": "node scripts/map-setup.mjs",
    "db:up": "docker compose up -d database",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.2",
    "prettier": "^3.6.2",
    "prisma": "6.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
