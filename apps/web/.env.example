NEXT_PUBLIC_API_BASE_URL=http://localhost:3113
# 지도 표시용 공개 키. 카카오 도메인 / Google HTTP referrer 제한을 설정하세요.
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# 운영에서는 Google Cloud에서 만든 JavaScript 지도 ID를 사용하세요.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# 기본 차단. Google 콘솔 지도 로드 한도 / 카카오 무료 쿼터 앱 확인 후 활성화.
# 서버에서 읽는 설정이며 NEXT_PUBLIC 접두사를 붙이지 않습니다.
GOOGLE_MAPS_WEB_ENABLED=false
KAKAO_MAPS_WEB_ENABLED=false
