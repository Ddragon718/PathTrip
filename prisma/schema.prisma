generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlaceCategory {
  RESTAURANT
  CAFE
  TOURIST_SPOT
  HOTEL
  PHOTO_SPOT
  ETC
}

enum PlacePriority {
  HIGH
  MEDIUM
  LOW
}

enum OptimizationType {
  DISTANCE
  TIME
  FOOD
  CAFE
  TOUR
  PHOTO
}

enum DestinationType {
  DOMESTIC
  INTERNATIONAL
}

enum MapPreference {
  AUTO
  KAKAO
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                     Int                     @id @default(autoincrement())
  email                  String                  @unique
  passwordHash           String                  @map("password_hash")
  nickname               String
  role                   UserRole                @default(USER)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")
  trips                  Trip[]
  regionVisits           RegionVisit[]
  visitorRecommendations VisitorRecommendation[]

  @@map("users")
}

model Trip {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  title           String
  region          String
  destinationType DestinationType @default(DOMESTIC) @map("destination_type")
  mapPreference   MapPreference   @default(AUTO) @map("map_preference")
  startDate       DateTime        @map("start_date") @db.Date
  endDate         DateTime        @map("end_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  places          Place[]
  routes          Route[]

  @@index([userId, deletedAt])
  @@index([startDate])
  @@map("trips")
}

model Place {
  id              Int           @id @default(autoincrement())
  tripId          Int           @map("trip_id")
  name            String
  googlePlaceId   String?       @map("google_place_id")
  category        PlaceCategory
  address         String?
  latitude        Float
  longitude       Float
  priority        PlacePriority @default(MEDIUM)
  stayTimeMinutes Int           @default(60) @map("stay_time_minutes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  trip            Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  routePlaces     RoutePlace[]

  @@index([tripId, deletedAt])
  @@index([category])
  @@index([latitude, longitude])
  @@map("places")
}

model Route {
  id                   Int              @id @default(autoincrement())
  tripId               Int              @map("trip_id")
  name                 String?
  totalDistanceMeters  Int              @default(0) @map("total_distance_meters")
  totalMoveTimeMinutes Int              @default(0) @map("total_move_time_minutes")
  optimizationType     OptimizationType @default(TIME) @map("optimization_type")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")
  trip                 Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places               RoutePlace[]

  @@index([tripId, deletedAt])
  @@map("routes")
}

model RoutePlace {
  id                          Int       @id @default(autoincrement())
  routeId                     Int       @map("route_id")
  placeId                     Int       @map("place_id")
  visitOrder                  Int       @map("visit_order")
  estimatedArrivalTime        DateTime? @map("estimated_arrival_time")
  moveTimeFromPreviousMinutes Int?      @map("move_time_from_previous_minutes")
  distanceFromPreviousMeters  Int?      @map("distance_from_previous_meters")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  route                       Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  place                       Place     @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@unique([routeId, visitOrder])
  @@unique([routeId, placeId])
  @@index([placeId])
  @@map("route_places")
}

model RegionVisit {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  regionId   String   @map("region_id")
  verifiedAt DateTime @map("verified_at")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, regionId])
  @@map("region_visits")
}

model VisitorRecommendation {
  id         Int           @id @default(autoincrement())
  userId     Int           @map("user_id")
  regionId   String        @map("region_id")
  category   PlaceCategory
  placeName  String        @map("place_name")
  address    String?
  note       String
  verifiedAt DateTime      @map("verified_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([regionId, category, deletedAt, createdAt])
  @@map("visitor_recommendations")
}

// Request attempts only; no API keys, queries, locations or provider content.
model ApiUsage {
  service      String   @id
  day          String   @db.VarChar(10)
  month        String   @db.VarChar(7)
  dailyCount   Int      @map("daily_count")
  monthlyCount Int      @map("monthly_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("api_usage")
}
